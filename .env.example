# ============================================================
# انسخ هذا الملف باسم .env وعبّي القيم الحقيقية.
# لا ترفع ملف .env نفسه لـ GitHub أبدًا (موجود بالفعل بـ .gitignore).
# ============================================================

# ============================================================
# قاعدة البيانات (Database) — PostgreSQL عبر Prisma
# ============================================================
# رابط الاتصال بقاعدة بيانات PostgreSQL — يُستخدم من Prisma Client وقت التشغيل.
#
# لو تستخدم Supabase: لازم يكون رابط الـ "Transaction pooler" (منفذ 6543)
# وليس الاتصال المباشر ولا الـ "Session pooler" — لوحة التحكم → Settings →
# Database → Connection pooling → Transaction mode. أضف ?pgbouncer=true
# بالنهاية دائمًا (مطلوب من Prisma مع PgBouncer/Supavisor). الـ Session pooler
# سقفه منخفض جدًا (15 اتصال) وبيفشل فورًا وقت "next build" لأن Next.js بيفتح
# اتصالات متوازية كتير وقت توليد الصفحات (SSG) — الـ Transaction pooler مصمم
# أصلًا لعدد اتصالات كبير قصير العمر وما عنده هالمشكلة.
#
# لو تستخدم Neon أو أي مزود آخر متوافق مع PostgreSQL، غالبًا الرابط المباشر يكفي.
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# مطلوب فقط لو DATABASE_URL أعلاه هو Transaction pooler — يُستخدم حصرًا من
# Prisma CLI (npx prisma db push / migrate)، لأن هذي العمليات تحتاج اتصال
# session-level كامل (مش متوفر بالـ transaction pooler).
# Supabase: نفس المشروع، بس Session pooler (منفذ 5432) أو الاتصال المباشر.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# ============================================================
# المصادقة (Auth) — تسجيل دخول لوحة التحكم عبر NextAuth
# ============================================================
# سر NextAuth — أي نص عشوائي طويل وسري. ولّده بأمر:
#   openssl rand -base64 32
NEXTAUTH_SECRET="ضع-هون-نص-عشوائي-طويل-وسري"

# رابط الموقع بعد النشر (بدون شرطة مائلة بالنهاية) — يُستخدم من NextAuth
# لبناء روابط الـ callback بشكل صحيح.
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# رابط الموقع العام (Site URL) — SEO وروابط مطلقة بالـ metadata/sitemap
# ============================================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================
# تخزين الصور (Image storage) — Supabase Storage، رفع شعارات المتاجر (لوحة التحكم فقط)
# ============================================================
# رابط مشروع Supabase — لوحة التحكم → Settings → API → Project URL
# (لو قاعدة بياناتك أصلًا على Supabase، الرابط هو نفس subdomain
# اللي بالـ DATABASE_URL لكن بدون "db." وبدون منفذ: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# مفتاح service_role — لوحة التحكم → Settings → API → Project API keys
# سرّي جدًا: يتجاوز كل صلاحيات RLS. لا تستخدمه أبدًا بكود client، ولا
# تضيف بادئة NEXT_PUBLIC_ له.
SUPABASE_SERVICE_ROLE_KEY="ضع-هون-مفتاح-service-role"

# ============================================================
# خدمة البريد الإلكتروني (Email service) — Resend، لإرسال رسائل نموذج التواصل
# ============================================================
# مفتاح API من لوحة تحكم Resend → API Keys. سرّي — خادم فقط، بدون
# بادئة NEXT_PUBLIC_، ولا يظهر أبدًا بأي كود client.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# البريد الإلكتروني اللي توصله رسائل نموذج التواصل — خادم فقط أيضًا،
# ما يظهر بأي كود client أو HTML مُرسل للزوار.
CONTACT_RECIPIENT_EMAIL="you@example.com"
